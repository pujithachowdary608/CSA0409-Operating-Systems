#include <stdio.h>
int main() {
    int pageSize, numPages;
    int pageTable[50];
    int pageNo, offset;
    int frameNo, physicalAddress;
    int i;
    printf("Enter Page Size: ");
    scanf("%d", &pageSize);
    printf("Enter Number of Pages: ");
    scanf("%d", &numPages);
    printf("Enter Frame Number for each Page:\n");
    for(i = 0; i < numPages; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &pageTable[i]);
    }
    printf("\nEnter Page Number: ");
    scanf("%d", &pageNo);
    printf("Enter Offset: ");
    scanf("%d", &offset);
    if(pageNo >= 0 && pageNo < numPages && offset >= 0 && offset < pageSize) {
        frameNo = pageTable[pageNo];
        physicalAddress = frameNo * pageSize + offset;
        printf("\nPage Number   : %d", pageNo);
        printf("\nFrame Number  : %d", frameNo);
        printf("\nOffset        : %d", offset);
        printf("\nPhysical Address = %d\n", physicalAddress);
    }
    else {
        printf("\nInvalid Page Number or Offset!\n");
    }
    return 0;
}

