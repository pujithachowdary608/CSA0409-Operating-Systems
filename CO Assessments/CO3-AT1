#include <stdio.h>
int main()
{
    float tlbTime, memoryTime;
    float hitRatio;
    float emat, withoutTLB;
    printf("Enter TLB Lookup Time (ns): ");
    scanf("%f", &tlbTime);
    printf("Enter Main Memory Access Time (ns): ");
    scanf("%f", &memoryTime);
    printf("Enter TLB Hit Ratio (0 to 1): ");
    scanf("%f", &hitRatio);
    withoutTLB = 2 * memoryTime;
    emat = hitRatio * (tlbTime + memoryTime)
         + (1 - hitRatio) * (tlbTime + 2 * memoryTime);
    printf("\nMemory Access Time without TLB = %.2f ns", withoutTLB);
    printf("\nEffective Memory Access Time with TLB = %.2f ns\n", emat);
    return 0;
}

-> OUTPUT :

Enter TLB Lookup Time (ns): 10
Enter Main Memory Access Time (ns): 100
Enter TLB Hit Ratio (0 to 1): 0.8

Memory Access Time without TLB = 200.00 ns
Effective Memory Access Time with TLB = 130.00 ns

