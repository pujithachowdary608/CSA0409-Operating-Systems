#include <stdio.h>
#include <stdlib.h>
int main() {
    int d[100]={0},a[100],v[100]={0},n,f,r,h,am,sm,i,j,c=0,x,p,m,seek=0;
    printf("Enter total number of disk blocks: ");scanf("%d",&n);
    printf("Enter file size (number of blocks required): ");scanf("%d",&f);
    printf("Enter number of disk requests: ");scanf("%d",&r);
    printf("Enter disk request queue:\n");
    for(i=0;i<r;i++)scanf("%d",&x);
    printf("Enter initial head position: ");scanf("%d",&h);
    printf("\nAllocation Methods:\n1. Contiguous\n2. Indexed\nEnter allocation method: ");
    scanf("%d",&am);
    printf("\nScheduling Methods:\n1. FCFS\n2. SSTF\nEnter scheduling method: ");
    scanf("%d",&sm);
    if(am==1){
        for(i=0;i<=n-f;i++){
            for(j=i;j<i+f&&d[j]==0;j++);
            if(j==i+f)break;
        }
        if(i>n-f){printf("\nAllocation Failed!\nNo sufficient contiguous space available.\n");return 0;}
        for(j=0;j<f;j++)a[c++]=i+j,d[i+j]=1;
        printf("\nAllocation Method: Contiguous\n");
    }else{
        for(i=0;i<n;i++)if(!d[i]){d[i]=1;printf("\nAllocation Method: Indexed\nIndex Block: %d\n",i);break;}
        for(i=0;i<n&&c<f;i++)if(!d[i])d[i]=1,a[c++]=i;
        if(c<f){printf("\nAllocation Failed!\nInsufficient free blocks for indexed allocation.\n");return 0;}
    }
    printf("Allocated Blocks: ");
    for(i=0;i<c;i++)printf("%d ",a[i]);
    printf("\n\nDisk Scheduling Method: ");
    if(sm==1){
        printf("FCFS\nSeek Sequence: %d",h);
        x=h;
        for(i=0;i<c;i++){seek+=abs(x-a[i]);x=a[i];printf(" -> %d",x);}
    }else{
        printf("SSTF\nSeek Sequence: %d",h);
        x=h;
        for(i=0;i<c;i++){
            m=9999;
            for(j=0;j<c;j++)if(!v[j]&&abs(x-a[j])<m)m=abs(x-a[j]),p=j;
            v[p]=1;seek+=m;x=a[p];printf(" -> %d",x);
        }
    }
    printf("\nTotal Seek Time: %d\n",seek);
    printf("\n============================================\n              PERFORMANCE\n============================================\n");
    printf("Allocation + Scheduling combination:\n");
    if(am==1&&sm==1)printf("Contiguous + FCFS\n");
    else if(am==1&&sm==2)printf("Contiguous + SSTF\n");
    else if(am==2&&sm==1)printf("Indexed + FCFS\n");
    else printf("Indexed + SSTF\n");
    printf("\nNote: To compare all four combinations, run the program\nwith each allocation and scheduling combination.\n");
    return 0;
}

