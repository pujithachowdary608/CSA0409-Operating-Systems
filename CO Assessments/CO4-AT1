    if (fileSize <= 0 || fileSize >= n)
    {
        printf("Invalid file size.\n");
        return 0;
    }
    printf("Enter number of disk requests: ");
    scanf("%d", &requestCount);
    if (requestCount <= 0 || requestCount > MAX)
    {
        printf("Invalid number of requests.\n");
        return 0;
    }
    printf("Enter disk request queue:\n");
    for (i = 0; i < requestCount; i++)
    {
        scanf("%d", &requestQueue[i]);

        if (requestQueue[i] < 0 || requestQueue[i] >= n)
        {
            printf("Invalid request block: %d\n", requestQueue[i]);
            return 0;
        }
    }
    printf("Enter initial head position: ");
    scanf("%d", &head);
    if (head < 0 || head >= n)
    {
        printf("Invalid head position.\n");
        return 0;
    }
    printf("\nAllocation Methods:\n");
    printf("1. Contiguous\n");
    printf("2. Indexed\n");
    printf("Enter allocation method: ");
    scanf("%d", &allocationMethod);
    if (allocationMethod != 1 && allocationMethod != 2)
    {
        printf("Invalid allocation method.\n");
        return 0;
    }
    printf("\nScheduling Methods:\n");
    printf("1. FCFS\n");
    printf("2. SSTF\n");
    printf("Enter scheduling method: ");
    scanf("%d", &schedulingMethod);
    if (schedulingMethod != 1 && schedulingMethod != 2)
    {
        printf("Invalid scheduling method.\n");
        return 0;
    }
    for (i = 0; i < n; i++)
        disk[i] = 0;
    if (allocationMethod == 1)
    {
        allocatedCount =
            contiguousAllocation(disk, n, fileSize, allocatedBlocks);
        if (allocatedCount == 0)
        {
            printf("\nAllocation Failed!\n");
            printf("No sufficient contiguous space available.\n");
            return 0;
        }
        printf("\nAllocation Method: Contiguous\n");
    }
    else
    {
        allocatedCount =
            indexedAllocation(disk, n, fileSize,
                              allocatedBlocks, &indexBlock);
        if (allocatedCount == 0)
        {
            printf("\nAllocation Failed!\n");
            printf("Insufficient free blocks for indexed allocation.\n");
            return 0;
        }
        printf("\nAllocation Method: Indexed\n");
        printf("Index Block: %d\n", indexBlock);
    }
    printf("Allocated Blocks: ");
    displayBlocks(allocatedBlocks, allocatedCount);
    printf("\nDisk Scheduling Method: ");
    if (schedulingMethod == 1)
    {
        printf("FCFS\n");
        int seekTime = fcfs(allocatedBlocks,
                            allocatedCount,
                            head);

        printf("Total Seek Time: %d\n", seekTime);
    }
    else
    {
        printf("SSTF\n");

        int seekTime = sstf(allocatedBlocks,
                            allocatedCount,
                            head);
        printf("Total Seek Time: %d\n", seekTime);
    }
    printf("\n============================================\n");
    printf("              PERFORMANCE\n");
    printf("============================================\n");
    printf("Allocation + Scheduling combination:\n");
    if (allocationMethod == 1 && schedulingMethod == 1)
        printf("Contiguous + FCFS\n");
    else if (allocationMethod == 1 && schedulingMethod == 2)
        printf("Contiguous + SSTF\n");
    else if (allocationMethod == 2 && schedulingMethod == 1)
        printf("Indexed + FCFS\n");
    else
        printf("Indexed + SSTF\n");
    printf("\nNote: To compare all four combinations, run the program\n");
    printf("with each allocation and scheduling combination.\n");
    return 0;
}

