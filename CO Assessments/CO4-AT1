        scanf("%d",&c);
        printf("Enter block numbers:\n");
        while(c--) {
            scanf("%d",&x);
            if(x>=0&&x<n&&b[x]) b[x]=0;
        }
    }
    printf("Bitmap: ");
    for(i=0;i<n;i++) printf("%d ",b[i]);
