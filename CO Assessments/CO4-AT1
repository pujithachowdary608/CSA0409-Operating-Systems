void contiguous(int disk[], int n, int fileSize)
{
    int i, j, start = -1;
    for (i = 0; i <= n - fileSize; i++)
    {
        int free = 1;
        for (j = i; j < i + fileSize; j++)
        {
            if (disk[j] != 0)
            {
                free = 0;
                break;
            }
        }
        if (free)
        {
            start = i;
            break;
        }
    }
    if (start == -1)
    {
        printf("Error: Contiguous allocation failed.\n");
        printf("No sufficient continuous free space available.\n");
        return;
    }
    printf("Allocated blocks: ");
    for (i = start; i < start + fileSize; i++)
    {
        disk[i] = 1;
        printf("%d ", i);
    }
    printf("\n");
}
void linked(int disk[], int n, int fileSize)
{
    int i, count = 0;
    for (i = 0; i < n && count < fileSize; i++)
    {
        if (disk[i] == 0)
        {
            disk[i] = 1;
            count++;
        }
    }
    if (count < fileSize)
    {
        printf("Error: Linked allocation failed.\n");
        printf("Insufficient free disk blocks.\n");
        return;
    }
    printf("Allocated blocks: ");
    for (i = 0; i < n; i++)
    {
        if (disk[i] == 1)
            printf("%d ", i);
    }
    printf("\n");
}
void indexed(int disk[], int n, int fileSize)
{
    int i, count = 0, indexBlock = -1;
    for (i = 0; i < n; i++)
    {
        if (disk[i] == 0)
        {
            indexBlock = i;
            disk[i] = 1;
            break;
        }
    }
    if (indexBlock == -1)
    {
        printf("Error: Indexed allocation failed.\n");
        printf("No free block available for index block.\n");
        return;
    }
    for (i = 0; i < n && count < fileSize; i++)
    {
        if (disk[i] == 0)
        {
            disk[i] = 1;
            count++;
        }
    }

    if (count < fileSize)
    {
        printf("Error: Indexed allocation failed.\n");
        printf("Insufficient free disk blocks.\n");
        return;
    }
    printf("Index block: %d\n", indexBlock);
    printf("Allocated data blocks: ");
    count = 0;
    for (i = 0; i < n && count < fileSize; i++)
    {
        if (disk[i] == 1 && i != indexBlock)
        {
            printf("%d ", i);
            count++;
        }
    }
    printf("\n");
}
