#include <stdio.h>
int main() {
    int d[100],n,f,ch,i,j,c=0,s=-1,idx=-1;
    printf("Enter total disk size (number of blocks): ");
    scanf("%d",&n);
    printf("Enter file size (number of blocks required): ");
    scanf("%d",&f);
    for(i=0;i<n;i++) d[i]=0;
    printf("\nFile Allocation Methods\n");
    printf("1. Contiguous Allocation\n2. Linked Allocation\n3. Indexed Allocation\n");
    printf("Enter allocation method: ");
    scanf("%d",&ch);
    if(ch==1) {
        for(i=0;i<=n-f;i++) {
            for(j=i;j<i+f&&d[j]==0;j++);
            if(j==i+f){s=i;break;}
        }
        if(s<0) printf("\n--- Contiguous Allocation ---\nError: Contiguous allocation failed.\nNo sufficient continuous free space available.\n");
        else {
            printf("\n--- Contiguous Allocation ---\nAllocated blocks: ");
            for(i=s;i<s+f;i++) printf("%d ",i);
        }
    }
    else if(ch==2) {
        printf("\n--- Linked Allocation ---\nAllocated blocks: ");
        for(i=0;i<n&&c<f;i++)
            if(!d[i]) {d[i]=1;printf("%d ",i);c++;}
        if(c<f) printf("\nError: Linked allocation failed.\nInsufficient free disk blocks.\n");
    }
    else if(ch==3) {
        for(i=0;i<n;i++) if(!d[i]){idx=i;d[i]=1;break;}
        for(i=0;i<n&&c<f;i++)
            if(!d[i]){d[i]=1;c++;}
        if(c<f) printf("\n--- Indexed Allocation ---\nError: Indexed allocation failed.\nInsufficient free disk blocks.\n");
        else {
            printf("\n--- Indexed Allocation ---\nIndex block: %d\nAllocated data blocks: ",idx);
            c=0;
            for(i=0;i<n&&c<f;i++)
                if(i!=idx&&d[i]){printf("%d ",i);c++;}
        }
    }
    else printf("Invalid allocation method.\n");
    return 0;
} 

