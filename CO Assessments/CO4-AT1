#include <stdio.h>
#include <stdlib.h>
#define MAX 100
int absValue(int x)
{
    return (x < 0) ? -x : x;
}
int fcfs(int requests[], int n, int head)
{
    int i, current = head, total = 0;
    printf("\nFCFS Seek Sequence: %d", head);
    for (i = 0; i < n; i++)
    {
        total += absValue(current - requests[i]);
        current = requests[i];
        printf(" -> %d", current);
    }
    printf("\nTotal Seek Time = %d\n", total);
    return total;
}
int sstf(int requests[], int n, int head)
{
    int visited[MAX] = {0};
    int i, count = 0;
    int current = head, total = 0;
    int minDistance, index, distance;
    printf("\nSSTF Seek Sequence: %d", head);
    while (count < n)
    {
        minDistance = 999999;
        index = -1;
        for (i = 0; i < n; i++)
        {
            if (!visited[i])
            {
                distance = absValue(current - requests[i]);
                if (distance < minDistance)
                {
                    minDistance = distance;
                    index = i;
                }
            }
        }
        visited[index] = 1;
        total += minDistance;
        current = requests[index];
        printf(" -> %d", current);
        count++;
    }
    printf("\nTotal Seek Time = %d\n", total);
    return total;
}
int scan(int requests[], int n, int head, int diskSize)
{
    int left[MAX], right[MAX];
    int leftCount = 0, rightCount = 0;
    int i, j, temp;
    int current = head;
    int total = 0;
    for (i = 0; i < n; i++)
    {
        if (requests[i] < head)
            left[leftCount++] = requests[i];
        else
            right[rightCount++] = requests[i];
    }
    for (i = 0; i < leftCount - 1; i++)
    {
        for (j = i + 1; j < leftCount; j++)
        {
            if (left[i] < left[j])
            {
                temp = left[i];
                left[i] = left[j];
                left[j] = temp;
            }
        }
    }
    for (i = 0; i < rightCount - 1; i++)
    {
        for (j = i + 1; j < rightCount; j++)
        {
            if (right[i] > right[j])
            {
                temp = right[i];
                right[i] = right[j];
                right[j] = temp;
            }
        }
    }
    printf("\nSCAN Seek Sequence: %d", head);
    for (i = 0; i < rightCount; i++)
    {
        total += absValue(current - right[i]);
        current = right[i];

        printf(" -> %d", current);
    }
    if (current != diskSize - 1)
    {
        total += absValue(current - (diskSize - 1));
        current = diskSize - 1;

        printf(" -> %d", current);
    }
    for (i = 0; i < leftCount; i++)
    {
        total += absValue(current - left[i]);
        current = left[i];

        printf(" -> %d", current);
    }
    printf("\nTotal Seek Time = %d\n", total);
    return total;
}
