#include <stdio.h>
#include <stdlib.h>
int main() {
    int a[100],v[100]={0},n,d,h,i,j,x,p,m,t1=0,t2=0,t3=0;
    printf("Enter disk size (number of cylinders): ");
    scanf("%d",&d);
    printf("Enter number of disk requests: ");
    scanf("%d",&n);
    printf("Enter disk request queue:\n");
    for(i=0;i<n;i++) scanf("%d",&a[i]);
    printf("Enter initial head position: ");
    scanf("%d",&h);
    printf("\n====================================\n     DISK SCHEDULING SIMULATION\n====================================\n");
    x=h; printf("\nFCFS Seek Sequence: %d",x);
    for(i=0;i<n;i++){t1+=abs(x-a[i]);x=a[i];printf(" -> %d",x);}
    printf("\nTotal Seek Time = %d\n",t1);
    x=h; printf("\nSSTF Seek Sequence: %d",x);
    for(i=0;i<n;i++){
        m=9999;
        for(j=0;j<n;j++) if(!v[j]&&abs(x-a[j])<m)m=abs(x-a[j]),p=j;
        v[p]=1;t2+=m;x=a[p];printf(" -> %d",x);
    }
    printf("\nTotal Seek Time = %d\n",t2);
    x=h; printf("\nSCAN Seek Sequence: %d",x);
    for(i=h;i<d;i++)
        for(j=0;j<n;j++) if(a[j]==i){t3+=abs(x-i);x=i;printf(" -> %d",x);}
    t3+=d-1-x;x=d-1;printf(" -> %d",x);
    for(i=h-1;i>=0;i--)
        for(j=0;j<n;j++) if(a[j]==i){t3+=abs(x-i);x=i;printf(" -> %d",x);}
    printf("\nTotal Seek Time = %d\n",t3);
    printf("\n====================================\n          PERFORMANCE COMPARISON\n====================================\n");
    printf("FCFS  Total Seek Time = %d\n",t1);
    printf("SSTF  Total Seek Time = %d\n",t2);
    printf("SCAN  Total Seek Time = %d\n",t3);
    printf("\nBest Performing Algorithm: ");
    if(t1<=t2&&t1<=t3)printf("FCFS\n");
    else if(t2<=t1&&t2<=t3)printf("SSTF\n");
    else printf("SCAN\n");
    return 0;
}

