#include <stdio.h>
#include <stdlib.h>
int main() {
    int a[100],n,d,h,i,j,x,t1=0,t2=0;
    char q;
    printf("Enter disk size (number of cylinders): ");
    scanf("%d",&d);
    printf("Enter number of requests: ");
    scanf("%d",&n);
    printf("Enter request queue:\n");
    for(i=0;i<n;i++)scanf("%d",&a[i]);
    printf("Enter initial head position: ");
    scanf("%d",&h);
    printf("Enter direction (L for Left, R for Right): ");
    scanf(" %c",&q);
    printf("\n========================================\n       DISK SCHEDULING SIMULATION\n========================================\n");
    x=h;printf("\nC-SCAN Seek Sequence: %d",x);
    if(q=='R'||q=='r'){
        for(i=h;i<d;i++)for(j=0;j<n;j++)if(a[j]==i){t1+=abs(x-i);x=i;printf(" -> %d",x);}
        t1+=d-1-x;x=d-1;printf(" -> %d",x);
        t1+=d-1;x=0;printf(" -> 0");
        for(i=0;i<h;i++)for(j=0;j<n;j++)if(a[j]==i){t1+=abs(x-i);x=i;printf(" -> %d",x);}
    }else{
        for(i=h;i>=0;i--)for(j=0;j<n;j++)if(a[j]==i){t1+=abs(x-i);x=i;printf(" -> %d",x);}
        t1+=x;x=0;printf(" -> 0");
        t1+=d-1;x=d-1;printf(" -> %d",x);
        for(i=d-1;i>h;i--)for(j=0;j<n;j++)if(a[j]==i){t1+=abs(x-i);x=i;printf(" -> %d",x);}
    }
    x=h;printf("\n\nLOOK Seek Sequence: %d",x);
    if(q=='R'||q=='r'){
        for(i=h;i<d;i++)for(j=0;j<n;j++)if(a[j]==i){t2+=abs(x-i);x=i;printf(" -> %d",x);}
        for(i=h-1;i>=0;i--)for(j=0;j<n;j++)if(a[j]==i){t2+=abs(x-i);x=i;printf(" -> %d",x);}
    }else{
        for(i=h;i>=0;i--)for(j=0;j<n;j++)if(a[j]==i){t2+=abs(x-i);x=i;printf(" -> %d",x);}
        for(i=h+1;i<d;i++)for(j=0;j<n;j++)if(a[j]==i){t2+=abs(x-i);x=i;printf(" -> %d",x);}
    }
    printf("\n\n========================================\n          PERFORMANCE COMPARISON\n========================================\n");
    printf("C-SCAN Total Head Movement = %d\n",t1);
    printf("LOOK  Total Head Movement = %d\n",t2);
    printf("\nConclusion: ");
    if(t1<t2)printf("C-SCAN performs better.\nIt requires less total head movement for this request queue.\n");
    else if(t2<t1)printf("LOOK performs better.\nIt requires less total head movement because it does not travel to\nthe physical end of the disk when there are no pending requests.\n");
    else printf("Both algorithms have the same performance.\n");
    return 0;
}

